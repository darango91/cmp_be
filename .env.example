# Environment configuration for the Cuidate Mas Pro backend.
#
# Copy this file to `.env` and adjust the values. The project reads plain
# environment variables (no auto-loading library), so export them into your
# shell before running management commands, e.g.:
#
#     set -a; source .env; set +a
#     uv run python manage.py runserver
#
# In deployment, set these through your platform's environment/secret manager.
# `.env` is gitignored; never commit real secrets.

# --- Core ------------------------------------------------------------------

# Debug mode. Leave True for local development; MUST be False in production.
DJANGO_DEBUG=True

# Secret key. A dev-only insecure default is used when this is unset, but it
# is REQUIRED when DJANGO_DEBUG=False. Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value

# Comma-separated host/domain names this site can serve. Required when
# DJANGO_DEBUG=False (defaults to localhost,127.0.0.1 in debug).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database --------------------------------------------------------------
# Leave everything below unset to use the bundled SQLite database.
# To use e.g. PostgreSQL, set DJANGO_DB_ENGINE plus the relevant fields.

# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_NAME=cmp
# DJANGO_DB_USER=cmp
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=127.0.0.1
# DJANGO_DB_PORT=5432

# --- Production hardening --------------------------------------------------
# Only applied when DJANGO_DEBUG=False.

# Redirect all HTTP traffic to HTTPS (default: True in production).
# DJANGO_SECURE_SSL_REDIRECT=True

# HTTP Strict Transport Security max-age in seconds (default: 2592000 = 30 days).
# DJANGO_SECURE_HSTS_SECONDS=2592000

# Set True when running behind a TLS-terminating proxy/load balancer so Django
# trusts the X-Forwarded-Proto header (default: False).
# DJANGO_USE_X_FORWARDED_PROTO=False
